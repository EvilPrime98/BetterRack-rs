import { Button, LineEdit, Switch } from "std-widgets.slint";
import { Theme } from "theme.slint";

export component SettingsScreen inherits Rectangle {
    in property <string> server-status;
    in property <string> data-dir;
    in property <[string]> folders;
    in property <string> folder-status;
    in-out property <string> remote-url;
    in property <bool> remote-linked;
    in-out property <string> store-url;
    in-out property <bool> wiki-search;
    in property <string> meta-status;
    property <string> key-text;
    callback save-store-url(string);
    callback set-wiki-search(bool);
    callback reidentify-all();
    callback add-folder();
    callback connect-server(string, string);
    callback disconnect-server();
    Flickable {
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        alignment: start;
        Text { text: "Settings"; color: Theme.text; font-size: 24px; font-weight: 700; }
        Text { text: "Embedded server: " + root.server-status; color: Theme.text; font-size: 16px; wrap: word-wrap; }
        Text { text: "Data: " + root.data-dir; color: Theme.muted; font-size: 14px; wrap: word-wrap; }
        Text { text: "Library folders"; color: Theme.text; font-size: 18px; font-weight: 700; }
        for folder in root.folders: Text {
            text: folder;
            color: Theme.text;
            font-size: 14px;
            wrap: word-wrap;
        }
        if !root.remote-linked: Button { text: "Add library folder"; clicked => { root.add-folder(); } }
        Text { text: "BetterRack server"; color: Theme.text; font-size: 18px; font-weight: 700; }
        if root.remote-linked: Text {
            text: "Linked to " + root.remote-url + ". The server is the source of truth.";
            color: Theme.text;
            font-size: 14px;
            wrap: word-wrap;
        }
        if root.remote-linked: Button { text: "Unlink server"; clicked => { root.disconnect-server(); } }
        if !root.remote-linked: LineEdit { placeholder-text: "Server address (host:port)"; text <=> root.remote-url; }
        if !root.remote-linked: LineEdit { placeholder-text: "API key (optional)"; text <=> root.key-text; input-type: password; }
        if !root.remote-linked: Button {
            text: "Link server";
            clicked => { root.connect-server(root.remote-url, root.key-text); }
        }
        Text { text: "Metadata"; color: Theme.text; font-size: 18px; font-weight: 700; }
        Switch { text: "Search the wiki for metadata"; checked: root.wiki-search; toggled => { root.set-wiki-search(self.checked); } }
        Button { text: "Re-identify all"; clicked => { root.reidentify-all(); } }
        if root.meta-status != "": Text { text: root.meta-status; color: Theme.muted; font-size: 14px; wrap: word-wrap; }
        Text { text: "Store"; color: Theme.text; font-size: 18px; font-weight: 700; }
        LineEdit { placeholder-text: "Store API address"; text <=> root.store-url; }
        Button { text: "Save store address"; clicked => { root.save-store-url(root.store-url); } }
        if root.folder-status != "": Text { text: root.folder-status; color: Theme.muted; font-size: 14px; wrap: word-wrap; }
    }
    }
}
