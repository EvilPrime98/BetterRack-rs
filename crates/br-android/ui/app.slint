import { Theme } from "theme.slint";
import { NavRail, NavBar } from "nav.slint";
import { LibraryScreen } from "library.slint";
import { Item } from "cover.slint";
import { ListsScreen } from "lists.slint";
import { SettingsScreen } from "settings.slint";
import { Reader } from "reader.slint";

export component App inherits Window {
    in property <[Item]> series;
    in property <[Item]> issues;
    in property <bool> detail-open;
    in property <string> detail-title;
    in-out property <int> filter;
    in property <bool> loading;
    in property <string> server-status;
    in property <string> data-dir;
    in property <[string]> folders;
    in property <string> folder-status;
    in-out property <string> remote-url;
    in property <bool> remote-linked;
    in property <[Item]> reading;
    in property <[Item]> recent;
    in property <bool> refreshing;
    callback refresh();
    callback list-cover-needed(int, int);
    callback open-list-item(int, int);
    callback search(string);
    callback set-filter(int);
    callback open-series(int);
    callback open-issue(int);
    in property <bool> reader-open;
    in property <image> reader-page;
    in property <bool> reader-has-page;
    in property <string> reader-message;
    in property <int> reader-total;
    in property <int> reader-current;
    in property <bool> reader-rtl;
    callback reader-close();
    callback reader-step(int);
    callback reader-seek(int);
    callback reader-toggle-direction();
    callback close-series();
    callback cover-needed(bool, int);
    callback add-folder();
    callback connect-server(string, string);
    callback disconnect-server();

    // One entry per destination; Phases 7-9 append here and add a branch to the `if` chain.
    property <[string]> destinations: ["Library", "Browse", "Settings"];
    property <int> tab: 0;
    property <bool> wide: self.width >= Theme.wide-breakpoint;

    background: Theme.bg;

    VerticalLayout {
        padding-top: root.safe-area-insets.top;
        padding-bottom: root.safe-area-insets.bottom;
        padding-left: root.safe-area-insets.left;
        padding-right: root.safe-area-insets.right;
        HorizontalLayout {
            if root.wide: NavRail {
                items: root.destinations;
                current <=> root.tab;
            }
            Rectangle {
                horizontal-stretch: 1;
                if root.tab == 0: LibraryScreen {
                    series: root.series;
                    issues: root.issues;
                    loading: root.loading;
                    detail-open: root.detail-open;
                    detail-title: root.detail-title;
                    filter <=> root.filter;
                    search(t) => { root.search(t); }
                    set-filter(f) => { root.set-filter(f); }
                    open-series(i) => { root.open-series(i); }
                    open-issue(i) => { root.open-issue(i); }
                    close-series => { root.close-series(); }
                    cover-needed(d, i) => { root.cover-needed(d, i); }
                }
                if root.tab == 1: ListsScreen {
                    reading: root.reading;
                    recent: root.recent;
                    refreshing: root.refreshing;
                    refresh => { root.refresh(); }
                    list-cover-needed(s, i) => { root.list-cover-needed(s, i); }
                    open-list-item(s, i) => { root.open-list-item(s, i); }
                }
                if root.tab == 2: SettingsScreen {
                    server-status: root.server-status;
                    data-dir: root.data-dir;
                    folders: root.folders;
                    folder-status: root.folder-status;
                    remote-url <=> root.remote-url;
                    remote-linked: root.remote-linked;
                    add-folder => { root.add-folder(); }
                    connect-server(url, key) => { root.connect-server(url, key); }
                    disconnect-server => { root.disconnect-server(); }
                }
            }
        }
        if !root.wide: NavBar {
            items: root.destinations;
            current <=> root.tab;
        }
    }

    if root.reader-open: Reader {
        width: root.width;
        height: root.height;
        page: root.reader-page;
        has-page: root.reader-has-page;
        message: root.reader-message;
        total: root.reader-total;
        current: root.reader-current;
        rtl: root.reader-rtl;
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        close => { root.reader-close(); }
        step(d) => { root.reader-step(d); }
        seek(n) => { root.reader-seek(n); }
        toggle-direction => { root.reader-toggle-direction(); }
    }
}
