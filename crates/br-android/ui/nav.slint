import { Theme } from "theme.slint";

export component NavButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();
    min-height: 56px;
    background: root.selected ? Theme.accent.with-alpha(0.18) : transparent;
    border-radius: 16px;
    Text {
        text: root.label;
        color: root.selected ? Theme.accent : Theme.muted;
        font-size: 14px;
        font-weight: root.selected ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea { clicked => { root.clicked(); } }
}

// Tablet and landscape: vertical rail on the left.
export component NavRail inherits Rectangle {
    in property <[string]> items;
    in-out property <int> current;
    width: Theme.nav-rail-width;
    background: Theme.surface;
    VerticalLayout {
        padding: 8px;
        spacing: 8px;
        alignment: start;
        for label[i] in root.items: NavButton {
            label: label;
            selected: root.current == i;
            clicked => { root.current = i; }
        }
    }
}

// Phone: bar along the bottom.
export component NavBar inherits Rectangle {
    in property <[string]> items;
    in-out property <int> current;
    height: Theme.nav-bar-height;
    background: Theme.surface;
    HorizontalLayout {
        padding: 6px;
        spacing: 6px;
        for label[i] in root.items: NavButton {
            label: label;
            selected: root.current == i;
            clicked => { root.current = i; }
        }
    }
}
